generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPORTE
  CLIENTE
}

enum UserStatus {
  ATIVO
  INATIVO
}

enum TicketStatus {
  ABERTO
  PENDENTE
  FECHADO
}

enum IncidentOrigin {
  FRONT
  BACK
  INFRA
  EVENT
  OUTROS
}

enum ContractStatus {
  ATIVO
  SUSPENSO
  CANCELADO
  FINALIZADO
}

enum ReceivableStatus {
  PENDENTE
  PAGO
  ATRASADO
  CANCELADO
}

enum PaymentMethod {
  PIX
  BOLETO
  TRANSFERENCIA
  CARTAO
  OUTRO
}

enum ProposalStatus {
  RASCUNHO
  ENVIADA
  EM_NEGOCIACAO
  APROVADA
  RECUSADA
  EXPIRADA
}

model User {
  id             String      @id @default(cuid())
  name           String
  email          String      @unique
  company        String
  contractNumber String?
  systemUrl      String?
  status         UserStatus  @default(ATIVO)
  role           Role        @default(CLIENTE)
  passwordHash   String
  deletedAt      DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  tickets     Ticket[]
  apiKeys     ApiKey[]
  contracts   ClientContract[]
  receivables ClientReceivable[]
  proposals   ClientProposal[]
  nfseInvoices NfseInvoice[]

  @@map("users")
}

model ApiKey {
  id         String    @id @default(cuid())
  name       String    @default("Default API Key")
  keyHash    String    @unique
  keyPrefix  String
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([keyHash])
  @@map("api_keys")
}

model Ticket {
  id              String         @id @default(cuid())
  ticketNumber    Int            @default(autoincrement())
  title           String
  description     String         @db.Text
  screenName      String         @default("Geral")
  status          TicketStatus   @default(ABERTO)
  origin          IncidentOrigin @default(OUTROS)
  fingerprint     String?
  occurrenceCount Int            @default(1)
  lastOccurrenceAt DateTime      @default(now())
  sourceUrl       String?
  targetUrl       String?
  slaDueAt        DateTime       @default(now())
  deletedAt       DateTime?
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  attachments TicketAttachment[]
  occurrences TicketOccurrence[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fingerprint, userId, status])
  @@map("tickets")
}

model TicketOccurrence {
  id         String         @id @default(cuid())
  ticketId   String
  ticket     Ticket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  origin     IncidentOrigin @default(OUTROS)
  occurredAt DateTime       @default(now())
  sourceUrl  String?
  targetUrl  String?
  stackTrace String?        @db.Text
  payload    String?        @db.Text
  headers    String?        @db.Text
  createdAt  DateTime       @default(now())

  @@index([ticketId])
  @@index([occurredAt])
  @@map("ticket_occurrences")
}

model TicketAttachment {
  id         String   @id @default(cuid())
  ticketId   String
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  fileName   String
  mimeType   String
  base64Data String   @db.Text
  createdAt  DateTime @default(now())

  @@map("ticket_attachments")
}

model ClientContract {
  id             String         @id @default(cuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  contractNumber String?
  title          String
  monthlyValue   Float          @default(0)
  billingDay     Int            @default(10)
  startDate      DateTime       @default(now())
  endDate        DateTime?
  status         ContractStatus @default(ATIVO)
  notes          String?        @db.Text
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  receivables ClientReceivable[]

  @@index([userId, status])
  @@map("client_contracts")
}

model ClientReceivable {
  id            String           @id @default(cuid())
  userId        String
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  contractId    String?
  contract      ClientContract?  @relation(fields: [contractId], references: [id], onDelete: SetNull)
  description   String
  competence    String           // e.g. "2026-09"
  amount        Float
  dueDate       DateTime
  paidDate      DateTime?
  paymentMethod PaymentMethod    @default(PIX)
  status        ReceivableStatus @default(PENDENTE)
  notes         String?          @db.Text
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  nfseInvoices  NfseInvoice[]

  @@index([userId, status])
  @@index([competence])
  @@map("client_receivables")
}

model ClientProposal {
  id               String         @id @default(cuid())
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  proposalNumber   String
  title            String
  scopeDescription String         @db.Text
  oneOffValue      Float          @default(0)
  monthlyValue     Float          @default(0)
  sentDate         DateTime       @default(now())
  validUntil       DateTime?
  status           ProposalStatus @default(ENVIADA)
  documentUrl      String?
  notes            String?        @db.Text
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([userId, status])
  @@map("client_proposals")
}

enum NfseStatus {
  RASCUNHO
  PROCESSANDO
  AUTORIZADA
  REJEITADA
  CANCELADA
  SUBSTITUIDA
}

enum NfseEnvironment {
  PRODUCAO
  PRODUCAO_RESTRITA
  SIMULADOR
}

enum NfseEventType {
  EMISSAO_SOLICITADA
  DPS_GERADA
  ASSINATURA_OK
  TRANSMISSAO_SUCESSO
  TRANSMISSAO_ERRO
  CONSULTA_STATUS
  CANCELAMENTO_SOLICITADO
  CANCELADA
  SUBSTITUICAO_SOLICITADA
  SUBSTITUIDA
}

model NfseConfig {
  id                          String          @id @default(cuid())
  environment                 NfseEnvironment @default(SIMULADOR)
  prestadorCnpj               String
  prestadorRazaoSocial        String
  prestadorNomeFantasia       String?
  prestadorInscricaoMunicipal String
  prestadorCodigoMunicipio    String          // Código IBGE (ex: 2611606 para Recife)
  prestadorOptanteSimples     Boolean         @default(true)
  prestadorRegimeEspecial     String?         // ex: "1" (Microempresa Municipal), "0" (Nenhum)
  prestadorAliquotaIss        Float           @default(2.0) // 2.00% a 5.00%
  codigoServicoLc116          String          @default("01.07") // Suporte técnico, manutenção etc
  codigoTributacaoMunicipal   String?         // Código interno municipal
  cnae                        String?         @default("6202000") // Desenvolvimento e licenciamento de software
  certificateBase64           String?         @db.Text
  certificatePassword         String?
  certificateExpiresAt        DateTime?
  apiRestUrl                  String?
  isConfigured                Boolean         @default(true)
  createdAt                   DateTime        @default(now())
  updatedAt                   DateTime        @updatedAt

  @@map("nfse_configs")
}

model NfseInvoice {
  id                          String          @id @default(cuid())
  userId                      String
  user                        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  receivableId                String
  receivable                  ClientReceivable @relation(fields: [receivableId], references: [id], onDelete: Cascade)
  environment                 NfseEnvironment @default(SIMULADOR)
  status                      NfseStatus      @default(PROCESSANDO)
  
  // Dados da DPS / NFS-e
  dpsNumero                   String?
  dpsSerie                    String          @default("1")
  numeroNfse                  String?
  chaveAcesso                 String?         @unique
  codigoVerificacao           String?
  dataEmissao                 DateTime        @default(now())
  dataCompetencia             DateTime        @default(now())
  
  // Valores Fiscais
  valorServicos               Float
  valorDeducoes               Float           @default(0)
  valorPis                    Float           @default(0)
  valorCofins                 Float           @default(0)
  valorInss                   Float           @default(0)
  valorIr                     Float           @default(0)
  valorCsll                   Float           @default(0)
  issRetido                   Boolean         @default(false)
  valorIss                    Float           @default(0)
  valorIssRetido              Float           @default(0)
  aliquotaIss                 Float           @default(2.0)
  valorLiquido                Float
  
  // Detalhes do Serviço
  discriminacaoServico        String          @db.Text
  codigoServicoLc116          String          @default("01.07")
  codigoCnae                  String?
  
  // Tomador (Cliente no momento da emissão)
  tomadorCpfCnpj              String
  tomadorRazaoSocial          String
  tomadorEmail                String?
  tomadorInscricaoMunicipal   String?
  tomadorEndereco             String?
  
  // Arquivos e URLs
  xmlEnviado                  String?         @db.Text
  xmlRetorno                  String?         @db.Text
  danfseUrl                   String?
  motivoRejeicao              String?         @db.Text
  motivoCancelamento          String?         @db.Text
  substituidaPorId            String?
  substituiId                 String?
  
  createdAt                   DateTime        @default(now())
  updatedAt                   DateTime        @updatedAt

  events                      NfseEvent[]

  @@index([userId, status])
  @@index([receivableId])
  @@index([numeroNfse])
  @@map("nfse_invoices")
}

model NfseEvent {
  id          String        @id @default(cuid())
  nfseId      String
  nfse        NfseInvoice   @relation(fields: [nfseId], references: [id], onDelete: Cascade)
  type        NfseEventType
  description String
  payload     String?       @db.Text
  createdAt   DateTime      @default(now())

  @@index([nfseId])
  @@map("nfse_events")
}

